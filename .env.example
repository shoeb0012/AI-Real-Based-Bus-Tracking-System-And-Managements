PORT=3000
NODE_ENV=development
TRUST_PROXY_HOPS=0

# Generate a private random value at least 32 characters long.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# The first Admin account is created once at server startup when these are set.
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters